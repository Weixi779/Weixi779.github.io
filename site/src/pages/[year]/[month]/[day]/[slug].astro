---
import type { CollectionEntry } from 'astro:content';
import {
  getLegacyPostRouteParts,
  getPostPath,
  getPublishedPosts,
} from '../../../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: getLegacyPostRouteParts(post),
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const targetPath = getPostPath(post);
const targetUrl = new URL(targetPath, Astro.site);
const refreshContent = `0;url=${targetPath}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={refreshContent} />
    <link rel="canonical" href={targetUrl} />
    <title>文章地址已更新 - 伟兮の小屋</title>
    <script is:inline define:vars={{ targetPath }}>
      window.location.replace(targetPath);
    </script>
  </head>
  <body>
    <main>
      <p>文章地址已更新，正在跳转……</p>
      <p><a href={targetPath}>如果没有自动跳转，请点击这里继续阅读。</a></p>
    </main>
  </body>
</html>
