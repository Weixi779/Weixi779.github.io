---
import HomeHero from '../../components/HomeHero.astro';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, type PostEntry } from '../../utils/posts';

interface Props {
  posts: PostEntry[];
  pageNumber: number;
  totalPages: number;
}

export async function getStaticPaths() {
  const pageSize = 10;
  const posts = await getPublishedPosts();
  const totalPages = Math.ceil(posts.length / pageSize);

  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const pageNumber = index + 2;
    const offset = (pageNumber - 1) * pageSize;
    return {
      params: { page: String(pageNumber) },
      props: {
        posts: posts.slice(offset, offset + pageSize),
        pageNumber,
        totalPages,
      },
    };
  });
}

const { posts, pageNumber, totalPages } = Astro.props;
---

<BaseLayout title={`第 ${pageNumber} 页`}>
  <HomeHero />
  <section class="content-container page-list">
    <PostList posts={posts} />
    <nav class="pager" aria-label="文章分页">
      <a href={pageNumber === 2 ? '/' : `/page/${pageNumber - 1}/`}>← 更新文章</a>
      {pageNumber < totalPages ? <a href={`/page/${pageNumber + 1}/`}>更早文章 →</a> : <span></span>}
    </nav>
  </section>
</BaseLayout>
