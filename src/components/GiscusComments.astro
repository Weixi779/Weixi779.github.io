<section class="comments" aria-label="文章评论">
  <div id="giscus-comments" data-theme-light="light" data-theme-dark="dark"></div>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="Weixi779/Weixi779.github.io"
    data-repo-id="MDEwOlJlcG9zaXRvcnkzODE5Nzk0MzA="
    data-category="Announcements"
    data-category-id="DIC_kwDOFsSLJs4C3eHH"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="preferred_color_scheme"
    data-lang="zh-CN"
    data-loading="lazy"
    crossorigin="anonymous"
    async
  ></script>
</section>

<script>
  type BlogThemeEvent = CustomEvent<{ theme: 'light' | 'dark' }>;

  function syncGiscusTheme(theme: 'light' | 'dark') {
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    if (!frame?.contentWindow) return;
    frame.contentWindow.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
  }

  window.addEventListener('blog-theme-change', (event) => {
    syncGiscusTheme((event as BlogThemeEvent).detail.theme);
  });

  const comments = document.querySelector('.comments');
  if (comments) {
    const observer = new MutationObserver(() => {
      const frame = document.querySelector('iframe.giscus-frame');
      if (!frame) return;
      const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      syncGiscusTheme(theme);
      observer.disconnect();
    });
    observer.observe(comments, { childList: true, subtree: true });
  }
</script>
