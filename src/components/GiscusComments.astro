<section class="comments" aria-label="文章评论">
  <div id="giscus-comments" data-theme-light="light" data-theme-dark="dark"></div>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="Weixi779/Weixi779.github.io"
    data-repo-id="MDEwOlJlcG9zaXRvcnkzODE5Nzk0MzA="
    data-category="Announcements"
    data-category-id="DIC_kwDOFsSLJs4C3eHH"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="preferred_color_scheme"
    data-lang="zh-CN"
    data-loading="lazy"
    crossorigin="anonymous"
    async
  ></script>
</section>

<script>
  import type { ColorMode, ColorModePreference, ThemeId } from '../theme/semantic-colors';

  type BlogThemeEvent = CustomEvent<{
    themeId: ThemeId;
    colorMode: ColorMode;
    modePreference: ColorModePreference;
  }>;

  function syncGiscusTheme(colorMode: ColorMode) {
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    if (!frame?.contentWindow) return;
    frame.contentWindow.postMessage(
      { giscus: { setConfig: { theme: colorMode } } },
      'https://giscus.app',
    );
  }

  window.addEventListener('blog-theme-change', (event) => {
    syncGiscusTheme((event as BlogThemeEvent).detail.colorMode);
  });

  const comments = document.querySelector('.comments');
  if (comments) {
    const observer = new MutationObserver(() => {
      const frame = document.querySelector('iframe.giscus-frame');
      if (!frame) return;
      const colorMode = document.documentElement.dataset.colorMode === 'dark' ? 'dark' : 'light';
      syncGiscusTheme(colorMode);
      observer.disconnect();
    });
    observer.observe(comments, { childList: true, subtree: true });
  }
</script>
