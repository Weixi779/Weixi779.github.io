---
import type { TocChapter } from '../utils/toc';

interface Props {
  chapters: TocChapter[];
  language?: 'zh-CN' | 'en';
}

const { chapters, language = 'zh-CN' } = Astro.props;
const isEnglish = language === 'en';
---

<nav class="toc" aria-label={isEnglish ? 'Table of contents' : '文章目录'}>
  <details open>
    <summary>{isEnglish ? 'Contents' : '本文目录'}</summary>
    <ol class="toc__chapters">
      {chapters.map(({ heading, children }) => (
        <li class="toc__chapter" data-toc-chapter={heading.slug}>
          <a class="toc__heading" href={`#${heading.slug}`}>
            <svg class="toc__indicator" aria-hidden="true" viewBox="0 0 8 38" preserveAspectRatio="none">
              <path d="M3.8 1.2C3.1 1.3 2.9 2.2 3 4.5L3.15 13.5L3.05 23.5L3.3 33.5Q3.45 36.3 3.9 37Q4.25 36.2 4.35 33.5L4.55 23.5L4.4 13.5L4.6 4.5C4.65 2.4 4.4 1.2 3.8 1.2Z" fill="currentColor" />
            </svg>
            {heading.text}
          </a>
          {children.length > 0 && (
            <div class="toc__children" data-toc-children inert>
              <div>
                <ol>
                  {children.map(child => (
                    <li style={`--toc-indent: ${Math.max(0, child.depth - heading.depth - 1) * 12}px`}>
                      <a href={`#${child.slug}`}>{child.text}</a>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          )}
        </li>
      ))}
    </ol>
  </details>
</nav>

<script>
  import { bindTableOfContents } from './table-of-contents';

  const toc = document.querySelector<HTMLElement>('.toc');
  const details = toc?.querySelector('details');
  if (details && window.matchMedia('(max-width: 820px)').matches) details.open = false;

  if (toc) {
    let dispose = bindTableOfContents(toc);
    window.addEventListener('pagehide', () => dispose());
    window.addEventListener('pageshow', event => {
      if (event.persisted) dispose = bindTableOfContents(toc, { restored: true });
    });
  }
</script>
