---
const modeOptions = [
  { value: 'system', label: '跟随系统' },
  { value: 'light', label: '浅色' },
  { value: 'dark', label: '深色' },
] as const;
---

<div class="theme-picker" data-theme-picker>
  <button
    class="theme-toggle"
    id="theme-toggle"
    type="button"
    aria-label="打开主题设置"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="theme-panel"
    data-theme-toggle
  >
    <span aria-hidden="true" class="theme-toggle__icon">◐</span>
    <span class="theme-toggle__label">主题</span>
  </button>

  <section
    class="theme-panel"
    id="theme-panel"
    role="dialog"
    aria-label="主题设置"
    data-theme-panel
    hidden
  >
    <header class="theme-panel__header">
      <strong>主题设置</strong>
    </header>

    <fieldset class="theme-panel__group theme-panel__group--mode">
      <legend>显示模式</legend>
      <div class="theme-modes">
        {
          modeOptions.map((option) => (
            <label class="theme-mode">
              <input
                type="radio"
                name="theme-mode"
                value={option.value}
                checked={option.value === 'system'}
                data-theme-mode-input
              />
              <span>{option.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
  </section>
</div>

<script>
  const picker = document.querySelector<HTMLElement>('[data-theme-picker]');
  const toggle = picker?.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const panel = picker?.querySelector<HTMLElement>('[data-theme-panel]');
  const modeInputs = Array.from(
    picker?.querySelectorAll<HTMLInputElement>('[data-theme-mode-input]') ?? [],
  );

  if (picker && toggle && panel) {
    const pickerRoot = picker;
    const toggleButton = toggle;
    const panelElement = panel;

    function syncControls() {
      const { modePreference } = window.blogTheme.getState();
      for (const input of modeInputs) input.checked = input.value === modePreference;
    }

    function setPanelOpen(open: boolean, returnFocus = false) {
      panelElement.hidden = !open;
      toggleButton.setAttribute('aria-expanded', String(open));
      toggleButton.setAttribute('aria-label', open ? '关闭主题设置' : '打开主题设置');
      if (open) {
        syncControls();
        modeInputs.find((input) => input.checked)?.focus();
      } else if (returnFocus) {
        toggleButton.focus();
      }
    }

    toggleButton.addEventListener('click', () => setPanelOpen(Boolean(panelElement.hidden)));
    for (const input of modeInputs) {
      input.addEventListener('change', () => {
        const mode = input.value;
        if (input.checked && (mode === 'light' || mode === 'dark' || mode === 'system')) {
          window.blogTheme.setPreference(mode);
        }
      });
    }
    document.addEventListener('pointerdown', (event) => {
      if (!panelElement.hidden && event.target instanceof Node && !pickerRoot.contains(event.target)) {
        setPanelOpen(false);
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panelElement.hidden) {
        event.preventDefault();
        setPanelOpen(false, true);
      }
    });
    window.addEventListener('blog-theme-change', syncControls);
    syncControls();
  }
</script>

<style>
  .theme-picker {
    position: relative;
    flex: none;
  }

  .theme-toggle[aria-expanded='true'] {
    border-color: var(--color-accent-primary);
    background: var(--color-accent-secondary);
    color: var(--color-accent-primary);
  }

  .theme-panel {
    position: absolute;
    z-index: 80;
    top: calc(100% + 12px);
    right: 0;
    width: min(350px, calc(100vw - 24px));
    padding: 16px;
    border: 1px solid color-mix(in srgb, var(--color-border-primary) 72%, transparent);
    border-radius: 16px;
    background: color-mix(in srgb, var(--color-surface-elevated) 92%, transparent);
    box-shadow: var(--shadow-elevated);
    color: var(--color-text-primary);
    animation: theme-panel-in 160ms ease-out;
  }

  .theme-panel[hidden] {
    display: none;
  }

  .theme-panel__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  .theme-panel__header strong {
    font-size: 0.92rem;
  }

  .theme-panel__group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .theme-panel__group legend {
    margin-bottom: 7px;
    color: var(--color-text-secondary);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .theme-mode {
    position: relative;
    cursor: pointer;
  }

  .theme-mode input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .theme-mode input:focus-visible + span {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .theme-modes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 3px;
    border: 1px solid var(--color-border-secondary);
    border-radius: 11px;
    background: color-mix(in srgb, var(--color-background-secondary) 72%, transparent);
  }

  .theme-mode span {
    display: grid;
    min-height: 34px;
    place-items: center;
    border-radius: 8px;
    color: var(--color-text-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      transform 120ms ease;
  }

  .theme-mode:hover span {
    color: var(--color-text-primary);
  }

  .theme-mode:active span {
    transform: scale(0.97);
  }

  .theme-mode input:checked + span {
    background: var(--color-surface-elevated);
    box-shadow: 0 1px 4px color-mix(in srgb, var(--color-text-primary) 12%, transparent);
    color: var(--color-accent-primary);
  }

  @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .theme-panel {
      -webkit-backdrop-filter: saturate(180%) blur(24px);
      backdrop-filter: saturate(180%) blur(24px);
    }
  }

  @keyframes theme-panel-in {
    from {
      opacity: 0;
      transform: translateY(-5px) scale(0.985);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .theme-panel {
      background: var(--color-surface-elevated);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-panel {
      animation: none;
    }

    .theme-mode span {
      transition: none;
    }
  }
</style>
