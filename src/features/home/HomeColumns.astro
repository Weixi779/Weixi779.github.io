---
// Created by weixi on 2026/11/20.
import type { Column } from '../columns/catalog';
import '../columns/column-link.css';

interface Props { columns: Column[] }
const { columns } = Astro.props;
---

<section class="home-columns" aria-labelledby="home-columns-heading">
  <header>
    <h2 id="home-columns-heading">精选专栏</h2>
    <a href="/columns/">全部专栏</a>
  </header>
  <div class="cards">
    {columns.map(column => (
      <a class="card column-link" href={`/columns/${column.slug}/`}>
        {column.cover && <img src={column.cover} alt="" loading="lazy" decoding="async" />}
        <div>
          <h3>{column.title}<small>{column.articles.length} 篇</small></h3>
          <p>{column.intro}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .home-columns { grid-column: 1 / -1; position: relative; min-width: 0; }
  .home-columns::before {
    content: ''; position: absolute; inset-block: 0; left: -24px; width: 1.5px;
    background: linear-gradient(var(--color-accent-primary), color-mix(in srgb, var(--color-accent-primary) 43%, transparent) 34%, transparent);
  }
  header { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 14px; }
  h2, h3 { margin: 0; font-family: 'LXGW WenKai Mono GB', 'PingFang SC', sans-serif; font-weight: 400; }
  h2 { font-size: 24px; }
  header a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-accent-primary); font-size: 14px; }
  a { text-decoration: none; }
  header a:hover { text-decoration: underline; text-underline-offset: 4px; }
  header a:focus-visible { outline: 2px solid var(--color-accent-primary); outline-offset: 4px; }
  .cards { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 24px 64px; align-items: center; }
  .card { --card-padding: 6px; display: grid; grid-template-columns: 86px minmax(0, 1fr); gap: 17px; align-items: center; margin: calc(-1 * var(--card-padding)); padding: var(--card-padding); border-radius: 5px; color: inherit; }
  .card:first-child { grid-row: 1 / span 2; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 24px; }
  .card:not(:has(img)) { grid-template-columns: 1fr; }
  img { display: block; width: 100%; align-self: stretch; height: 100%; min-height: 78px; contain: size; object-fit: cover; }
  .card:first-child img { min-height: 220px; }
  h3 { font-size: 21px; line-height: 1.45; }
  .card:first-child h3 { font-size: 30px; }
  small { display: inline-block; margin-left: 10px; font: 12px/1.7 'Weixi Sans', sans-serif; color: var(--color-text-secondary); }
  p { margin: 4px 0 0; color: var(--color-text-secondary); font: 14px/1.85 'Weixi Sans', sans-serif; }
  .card:first-child p { margin-top: 9px; font-size: 15px; }
  @media (max-width: 1200px) { .home-columns::before { left: -14px; } }
  @media (max-width: 900px) {
    .cards { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .card:first-child { grid-row: auto; }
    .card { grid-template-columns: 76px minmax(0, 1fr); }
    img { min-height: 63px; }
    .card:first-child img { min-height: clamp(130px, 24vw, 230px); }
  }
  @media (max-width: 520px) {
    .card:first-child { display: block; }
    .card:first-child img { height: auto; min-height: 0; aspect-ratio: 2.35; margin-bottom: var(--card-padding); }
    .card:first-child h3 { font-size: 25px; }
    h3 { font-size: 19px; }
  }
  @media (max-width: 359px) { .home-columns::before { left: -8px; } }
</style>
