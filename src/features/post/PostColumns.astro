---
// Created by weixi on 2026/11/20.
import type { Column } from '../columns/catalog';
import '../columns/column-link.css';

interface Props { columns: Column[]; isEnglish: boolean }
const { columns, isEnglish } = Astro.props;
---

<nav class="post-columns" aria-labelledby="post-columns-heading">
  <div class="box">
    <div id="post-columns-heading">{isEnglish ? 'In these columns (in Chinese)' : '本文收录于专栏'}</div>
    {columns.map(column => (
      <a class="column-link" href={`/columns/${column.slug}/`} lang="zh-CN">
        {column.cover && <img src={column.cover} alt="" width="52" height="38" loading="lazy" decoding="async" />}
        <span>
          <strong>{column.title}</strong>
          <small>{(column.summaryPhrases ?? [column.intro]).map(phrase => <span>{phrase}</span>)}</small>
        </span>
        <span class="arrow" aria-hidden="true">›</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .post-columns { margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--markdown-color-border); font-family: 'Weixi Sans', sans-serif; }
  .post-columns + :global(.post-navigation) { margin-top: 12px; padding-top: 0; border-top: 0; }
  .box { border: 1px solid var(--markdown-color-border-soft); border-radius: 10px; padding: 9px 15px 3px; }
  #post-columns-heading { color: var(--markdown-color-muted); font-size: 12px; }
  .box a { --row-padding: 6px; display: grid; grid-template-columns: 52px minmax(0, 1fr) auto; align-items: center; gap: 12px; margin-inline: calc(-1 * var(--row-padding)); padding: var(--row-padding); border-radius: 3px; color: var(--markdown-color-text); text-decoration: none; }
  a + a { box-shadow: 0 -1px var(--markdown-color-border-soft); }
  a:not(:has(img)) { grid-template-columns: minmax(0, 1fr) auto; }
  .box img { display: block; width: 52px; height: 100%; min-height: 38px; align-self: stretch; contain: size; margin: 0; object-fit: cover; border-radius: 3px; }
  strong, small { display: block; }
  strong { font: 400 18px/1.5 'LXGW WenKai Mono GB', sans-serif; }
  small { font-size: 13px; line-height: 1.55; color: var(--markdown-color-muted); }
  small span { display: inline-block; max-width: 100%; white-space: pre-wrap; vertical-align: top; }
  .arrow { color: var(--markdown-color-muted); font: 20px/1 sans-serif; }
  @media (max-width: 600px) {
    .post-columns { margin-top: 36px; }
    .box { padding-inline: 12px; }
    .box a { gap: 10px; }
    strong { font-size: 17px; }
  }
</style>
