{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline editorial choices",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "level"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Article slug, or a unique series id"
          },
          "level": {
            "enum": [
              "large",
              "medium",
              "small"
            ]
          },
          "intro": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "related": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "column": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependentRequired": {
          "members": [
            "title"
          ]
        },
        "oneOf": [
          {
            "required": [
              "intro"
            ],
            "not": {
              "required": [
                "column"
              ]
            }
          },
          {
            "required": [
              "column"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "intro"
                  ]
                },
                {
                  "required": [
                    "title"
                  ]
                },
                {
                  "required": [
                    "members"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  }
}
