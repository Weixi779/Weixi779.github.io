---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { defaultThemeId, themeIds, themeStorageKey } from '../theme/semantic-colors';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  language?: 'zh-CN' | 'en';
  alternates?: Array<{
    language: 'zh-CN' | 'en' | 'x-default';
    href: string;
  }>;
}

const {
  title,
  description,
  image = '/images/banner.jpg',
  language = 'zh-CN',
  alternates = [],
} = Astro.props;
const resolvedDescription = description ?? (language === 'en' ? 'A personal record of learning and growth' : '个人博客记录成长');
const siteTitle = '伟兮の小屋';
const fullTitle = title ? `${title} - ${siteTitle}` : siteTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const ogLocale = language === 'en' ? 'en_US' : 'zh_CN';
---

<!doctype html>
<html
  lang={language}
  data-theme-id={defaultThemeId}
  data-color-mode="light"
  data-color-mode-preference="system"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={resolvedDescription} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.language}
        href={new URL(alternate.href, Astro.site)}
      />
    ))}
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS`} href="/rss.xml" />
    <link rel="icon" href="/images/favicon.ico" />
    <title>{fullTitle}</title>
    <script
      is:inline
      data-default-theme={defaultThemeId}
      data-theme-ids={JSON.stringify(themeIds)}
      data-storage-key={themeStorageKey}
    >
      (() => {
        const bootstrap = document.currentScript;
        const defaultThemeId = bootstrap?.dataset.defaultTheme ?? 'deepSeaMilk';
        const themeIds = JSON.parse(bootstrap?.dataset.themeIds ?? '[]');
        const themeStorageKey = bootstrap?.dataset.storageKey ?? 'blog-theme-preference';
        let preference = null;
        try {
          const stored = localStorage.getItem(themeStorageKey);
          preference = stored ? JSON.parse(stored) : null;
        } catch {}

        const storedThemeId = preference?.themeId;
        const storedMode = preference?.mode;
        const systemDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches;
        const themeId = themeIds.includes(storedThemeId) ? storedThemeId : defaultThemeId;
        const colorModePreference =
          storedMode === 'light' || storedMode === 'dark' || storedMode === 'system'
            ? storedMode
            : 'system';
        const colorMode =
          colorModePreference === 'light' || colorModePreference === 'dark'
            ? colorModePreference
            : systemDark
              ? 'dark'
              : 'light';

        document.documentElement.dataset.themeId = themeId;
        document.documentElement.dataset.colorModePreference = colorModePreference;
        document.documentElement.dataset.colorMode = colorMode;
      })();
    </script>
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
