---
import SiteFooter from '../components/SiteFooter';
import SiteHeader from '../components/SiteHeader';
import themeBootstrap from 'virtual:theme-bootstrap';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  language?: 'zh-CN' | 'en';
  alternates?: Array<{
    language: 'zh-CN' | 'en' | 'x-default';
    href: string;
  }>;
}

const {
  title,
  description,
  image = '/images/banner.jpg',
  language = 'zh-CN',
  alternates = [],
} = Astro.props;
const resolvedDescription = description ?? (language === 'en' ? 'A personal record of learning and growth' : '个人博客记录成长');
const siteTitle = '伟兮の小屋';
const fullTitle = title ? `${title} - ${siteTitle}` : siteTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const ogLocale = language === 'en' ? 'en_US' : 'zh_CN';
const goatcounterEndpoint = import.meta.env.PUBLIC_GOATCOUNTER_ENDPOINT;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={resolvedDescription} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline data-theme-bootstrap set:html={themeBootstrap}></script>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.language}
        href={new URL(alternate.href, Astro.site)}
      />
    ))}
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS`} href="/rss.xml" />
    <link
      rel="icon"
      type="image/x-icon"
      sizes="16x16 32x32 48x48 64x64 128x128 256x256"
      href="/images/favicon.ico?v=xi-20260924-2"
    />
    <title>{fullTitle}</title>
    {import.meta.env.PROD && goatcounterEndpoint && (
      <script
        is:inline
        data-goatcounter={goatcounterEndpoint}
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </head>
  <body>
    <SiteHeader pathname={Astro.url.pathname} client:load />
    <main>
      <slot />
    </main>
    <SiteFooter year={new Date().getFullYear()} client:load />
  </body>
</html>
