---
import PostColumns from '../features/post/PostColumns.astro';
import { getPublishedColumns } from '../features/columns/published-columns';
import type { PostEntry } from '../lib/content/posts';
import GiscusComments from '../features/post/GiscusComments.astro';
import TableOfContents from '../features/post/TableOfContents.astro';
import PostReadingArea from '../features/post/PostReadingArea.astro';
import SiteBanner from '../components/site/SiteBanner';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';
import { getPostPath } from '../lib/content/posts';
import { groupTocHeadings } from '../features/post/toc';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: PostEntry;
  translation?: PostEntry;
  headings: Heading[];
  newerPost?: PostEntry;
  olderPost?: PostEntry;
}

const { post, translation, headings, newerPost, olderPost } = Astro.props;
const heroImage = post.data.hero || '/images/banner.jpg';
const language = post.data.lang;
const isEnglish = language === 'en';
const chapters = post.data.toc ? groupTocHeadings(headings) : [];
const hasToc = chapters.length > 0;
const chinesePost = language === 'zh-CN' ? post : translation;
const columns = chinesePost && !post.data.draft
  ? (await getPublishedColumns()).filter(column => column.articles.some(article => article.slug === chinesePost.data.slug))
  : [];
const englishPost = language === 'en' ? post : translation;
const alternates = [
  ...(chinesePost ? [{ language: 'zh-CN' as const, href: getPostPath(chinesePost) }] : []),
  ...(englishPost ? [{ language: 'en' as const, href: getPostPath(englishPost) }] : []),
  ...(chinesePost ? [{ language: 'x-default' as const, href: getPostPath(chinesePost) }] : []),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  image={heroImage}
  language={language}
  alternates={alternates}
>
  <SiteBanner
    title={post.data.title}
    summary={post.data.summary}
    category={post.data.category}
    publishedAt={post.data.publishedAt.slice(0, 10)}
    image={post.data.hero}
    nightImage={post.data.heroNight}
    imageLayout={post.data.heroLayout}
    language={language}
    translations={chinesePost && englishPost ? [
      { href: getPostPath(chinesePost), language: 'zh-CN', label: '中文', current: !isEnglish },
      { href: getPostPath(englishPost), language: 'en', label: 'English', current: isEnglish },
    ] : []}
  />
  <PostReadingArea hasToc={hasToc}>
    {hasToc && <TableOfContents chapters={chapters} language={language} />}
    <article class="prose prose--article">
      <slot />
      {columns.length > 0 && <PostColumns columns={columns} isEnglish={isEnglish} />}
      <nav class="post-navigation" aria-label={isEnglish ? 'Adjacent posts' : '相邻文章'}>
        {newerPost ? (
          <a href={getPostPath(newerPost)}>
            <span>{isEnglish ? '← Newer post' : '← 更新文章'}</span>
            <strong>{newerPost.data.title}</strong>
          </a>
        ) : <span></span>}
        {olderPost ? (
          <a href={getPostPath(olderPost)}>
            <span>{isEnglish ? 'Older post →' : '更早文章 →'}</span>
            <strong>{olderPost.data.title}</strong>
          </a>
        ) : <span></span>}
      </nav>
      {!post.data.draft && <GiscusComments language={language} />}
    </article>
  </PostReadingArea>
</BaseLayout>
