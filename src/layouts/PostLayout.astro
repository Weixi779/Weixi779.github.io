---
import type { PostEntry } from '../utils/posts';
import GiscusComments from '../components/GiscusComments.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SiteBanner from '../components/SiteBanner';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';
import { getPostPath } from '../utils/posts';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: PostEntry;
  translation?: PostEntry;
  headings: Heading[];
  newerPost?: PostEntry;
  olderPost?: PostEntry;
}

const { post, translation, headings, newerPost, olderPost } = Astro.props;
const heroImage = post.data.hero || '/images/banner.jpg';
const language = post.data.lang;
const isEnglish = language === 'en';
const chinesePost = language === 'zh-CN' ? post : translation;
const englishPost = language === 'en' ? post : translation;
const alternates = [
  ...(chinesePost ? [{ language: 'zh-CN' as const, href: getPostPath(chinesePost) }] : []),
  ...(englishPost ? [{ language: 'en' as const, href: getPostPath(englishPost) }] : []),
  ...(chinesePost ? [{ language: 'x-default' as const, href: getPostPath(chinesePost) }] : []),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  image={heroImage}
  language={language}
  alternates={alternates}
>
  <div class:list={{ 'observer-banner': post.data.slug === 'observer', 'coffee-banner': post.data.slug === 'caffeine-moka-cache-notes' }}>
    <SiteBanner
      title={post.data.title}
      summary={post.data.summary}
      category={post.data.category}
      publishedAt={post.data.publishedAt.slice(0, 10)}
      image={post.data.hero}
      nightImage={post.data.heroNight}
      language={language}
      translations={chinesePost && englishPost ? [
        { href: getPostPath(chinesePost), language: 'zh-CN', label: '中文', current: !isEnglish },
        { href: getPostPath(englishPost), language: 'en', label: 'English', current: isEnglish },
      ] : []}
    />
  </div>
  <div class="post-shell">
    {post.data.toc && <TableOfContents headings={headings} language={language} />}
    <article class="prose">
      <slot />
      <nav class="post-navigation" aria-label={isEnglish ? 'Adjacent posts' : '相邻文章'}>
        {newerPost ? (
          <a href={getPostPath(newerPost)}>
            <span>{isEnglish ? '← Newer post' : '← 更新文章'}</span>
            <strong>{newerPost.data.title}</strong>
          </a>
        ) : <span></span>}
        {olderPost ? (
          <a href={getPostPath(olderPost)}>
            <span>{isEnglish ? 'Older post →' : '更早文章 →'}</span>
            <strong>{olderPost.data.title}</strong>
          </a>
        ) : <span></span>}
      </nav>
      <GiscusComments language={language} />
    </article>
  </div>
</BaseLayout>

<style>
  .observer-banner :global(.site-banner__scene) {
    width: min(84%, 890px);
    background-size: cover;
    background-position: right center;
    mask-image: linear-gradient(90deg, transparent, #000 55%),
      linear-gradient(180deg, #000 75%, transparent 100%);
  }

  @media (max-width: 700px) {
    .coffee-banner :global(.site-banner__scene) {
      width: 100%;
      right: 0;
      background-position: right top;
    }

    .observer-banner :global(.site-banner__inner) {
      padding-bottom: 300px;
    }

    .observer-banner :global(.site-banner__scene) {
      top: auto;
      bottom: 0;
      right: 0;
      width: 100%;
      height: 280px;
      max-height: none;
      background-size: cover;
      background-position: right center;
      opacity: .86;
      mask-image: linear-gradient(180deg, transparent, #000 16%, #000 80%, transparent);
    }

    :global(:root[data-color-mode='dark']) .observer-banner :global(.site-banner__scene) {
      opacity: .8;
    }
  }
</style>
