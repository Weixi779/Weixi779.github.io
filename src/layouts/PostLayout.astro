---
import type { PostEntry } from '../utils/posts';
import GiscusComments from '../components/GiscusComments.astro';
import TableOfContents from '../components/TableOfContents.astro';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';
import { getPostPath } from '../utils/posts';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: PostEntry;
  headings: Heading[];
  newerPost?: PostEntry;
  olderPost?: PostEntry;
}

const { post, headings, newerPost, olderPost } = Astro.props;
const heroImage = post.data.hero || '/images/banner.jpg';
---

<BaseLayout title={post.data.title} description={post.data.summary} image={heroImage}>
  <header class="page-hero" style={`--hero-image: url('${heroImage}')`}>
    <div class="page-hero__overlay">
      <div class="page-hero__content">
        <h1>{post.data.title}</h1>
        <p class="page-hero__summary">{post.data.summary}</p>
      </div>
    </div>
  </header>
  <div class="post-shell">
    {post.data.toc && <TableOfContents headings={headings} />}
    <article class="prose">
      <slot />
      <nav class="post-navigation" aria-label="相邻文章">
        {newerPost ? (
          <a href={getPostPath(newerPost)}>
            <span>← 更新文章</span>
            <strong>{newerPost.data.title}</strong>
          </a>
        ) : <span></span>}
        {olderPost ? (
          <a href={getPostPath(olderPost)}>
            <span>更早文章 →</span>
            <strong>{olderPost.data.title}</strong>
          </a>
        ) : <span></span>}
      </nav>
      <GiscusComments />
    </article>
  </div>
</BaseLayout>
