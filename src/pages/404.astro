---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteBanner from '../components/site/SiteBanner';
---

<BaseLayout title="404" description="你来到了没有知识的荒原">
  <div class="not-found">
    <SiteBanner eyebrow="404" title="你来到了没有知识的荒原">
      <nav class="not-found__links" aria-label="继续浏览">
        <a href="/">返回首页</a>
        <a href="/archive/">浏览归档</a>
      </nav>
    </SiteBanner>
  </div>
</BaseLayout>

<style>
  .not-found { display: grid; align-items: center; min-height: 70svh; }
  .not-found :global(.site-banner h1) { max-width: 14em; text-wrap: balance; }
  .not-found__links { display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 14px; }
  .not-found__links a { display: inline-flex; align-items: center; min-height: 44px; text-underline-offset: 5px; }
  .not-found__links a:focus-visible { outline: 2px solid var(--color-accent-primary); outline-offset: 4px; }
</style>
