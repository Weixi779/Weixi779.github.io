---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteBanner from '../components/SiteBanner';
import '../styles/prose.css';

const pages = await getCollection('pages');
const about = pages[0];

if (!about) {
  throw new Error('About page content was not found.');
}

const { Content } = await render(about);
const heroImage = about.data.hero || '/images/about_banner.jpg';
// The banner keeps the line break; metadata wants a single run of text.
const metaDescription = about.data.description?.replace(/\s*\n\s*/gu, ' ');
---

<BaseLayout title={about.data.title} description={metaDescription} image={heroImage}>
  <div class="about-banner">
    <SiteBanner title={about.data.title} summary={about.data.description} image={heroImage}
      avatar={{ src: '/images/avatar.webp', alt: '伟兮的头像' }} />
  </div>
  <div class="content-container about-body">
    <article class="prose prose--page">
      <Content />
    </article>
  </div>
</BaseLayout>

<style>
  .about-banner :global(.site-banner__scene) {
    width: 70%;
    background-position: center top;
    opacity: .76;
    mask-image: linear-gradient(90deg, transparent, #000 56%),
      linear-gradient(180deg, #000 48%, transparent 100%);
  }

  .about-banner :global(.page-hero__summary) {
    max-width: 420px;
    white-space: pre-line;
  }

  /* Keep the reading column on the same left edge as the banner title. */
  .about-body :global(.prose--page) {
    width: 100%;
    max-width: 760px;
    margin: 0;
    padding: 0;
  }

  :global(:root[data-color-mode='dark']) .about-banner :global(.site-banner__scene) {
    opacity: .84;
    mask-image: linear-gradient(90deg, transparent, #000 50%),
      linear-gradient(180deg, #000 48%, transparent 100%);
  }

  @media (max-width: 700px) {
    .about-banner :global(.site-banner__scene) {
      width: 110%;
      right: -30%;
      opacity: .62;
    }

    .about-banner :global(.page-hero__summary) {
      max-width: none;
    }
  }

  @media (max-width: 359px) {
    .about-banner :global(.page-hero__summary) {
      font-size: 12px;
    }
  }
</style>
