---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteBanner from '../components/SiteBanner';
import '../styles/prose.css';

const pages = await getCollection('pages');
const about = pages[0];

if (!about) {
  throw new Error('About page content was not found.');
}

const { Content } = await render(about);
const heroImage = about.data.hero || '/images/about_banner.jpg';
---

<BaseLayout title={about.data.title} description={about.data.description} image={heroImage}>
  <SiteBanner title={about.data.title} summary={about.data.description} image={heroImage} />
  <article class="prose prose--page">
    <Content />
  </article>
</BaseLayout>
