---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteBanner from '../components/site/SiteBanner';
import '../styles/prose.css';

const pages = await getCollection('pages');
const about = pages[0];

if (!about) {
  throw new Error('About page content was not found.');
}

const { Content } = await render(about);
const heroImage = about.data.hero || '/images/about_banner.jpg';
// The banner keeps the line break; metadata wants a single run of text.
const metaDescription = about.data.description?.replace(/\s*\n\s*/gu, ' ');
---

<BaseLayout title={about.data.title} description={metaDescription} image={heroImage}>
  <div class="about-banner">
    <SiteBanner title={about.data.title} summary={about.data.description} image={heroImage}
      avatar={{ src: '/images/avatar.webp', alt: '伟兮的头像' }}>
      <a class="timeline-entry" href="/about/timeline/">一路走来 ↗</a>
    </SiteBanner>
  </div>
  <div class="content-container about-body">
    <article class="prose prose--page">
      <Content />
    </article>
    <details class="art-credit" id="art-credit">
      <summary>文章页插画署名</summary>
      <p>白天的小龙娘参考图集第 13 号《白紫龙娘小 GPT 三视图设定》。<a href="https://xn--pssy23gqgbz2d718b.com/works/gpt202610310001.html">原图收录页</a>的图片署名为「这个刀子真甜」，原作者与授权状态均未确认。</p>
      <p>夜晚的 Gemini 猫娘原案出自 ZipZipPipe（胖次狐）的<a href="https://www.pixiv.net/artworks/148186519">《AI 娘化》</a>。作者允许署名取用、非商业使用，也在<a href="https://www.bilibili.com/video/BV1bARXBYEZz/">作品简介</a>中说明可以拿去再创作。</p>
      <p>两张页角插画均由 ImageGen 参考 <a href="https://github.com/lmy414/ai-chan-sheets">lmy414 整理的设定图</a>改绘。图集的补全工作与小屋新增的便服、纸船动作改绘部分采用
        <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>。原图的署名与许可另见<a href="https://github.com/lmy414/ai-chan-sheets/blob/main/版权与授权.md">图集说明</a>。</p>
    </details>
  </div>
</BaseLayout>

<style>
  .art-credit { max-width: 760px; margin-top: 28px; font-size: 13px; color: var(--color-text-secondary); }
  .art-credit summary { width: fit-content; cursor: pointer; }
  .timeline-entry { display: inline-block; margin-top: 20px; font-size: 13px; text-decoration: none; }
  .timeline-entry:hover { text-decoration: underline; text-underline-offset: 5px; }
  .timeline-entry:focus-visible { outline: 2px solid var(--color-accent-primary); outline-offset: 5px; }
  .about-banner :global(.site-banner__scene) {
    width: 70%;
    background-position: center top;
    opacity: .76;
    mask-image: linear-gradient(90deg, transparent, #000 56%),
      linear-gradient(180deg, #000 48%, transparent 100%);
  }

  .about-banner :global(.page-hero__summary) {
    max-width: 420px;
    white-space: pre-line;
  }

  /* Keep the reading column on the same left edge as the banner title. */
  .about-body :global(.prose--page) {
    width: 100%;
    max-width: 760px;
    margin: 0;
    padding: 0;
  }

  :global(:root[data-color-mode='dark']) .about-banner :global(.site-banner__scene) {
    opacity: .84;
    mask-image: linear-gradient(90deg, transparent, #000 50%),
      linear-gradient(180deg, #000 48%, transparent 100%);
  }

  @media (max-width: 700px) {
    .about-banner :global(.site-banner__scene) {
      width: 110%;
      right: -30%;
      opacity: .62;
    }

    .about-banner :global(.page-hero__summary) {
      max-width: none;
    }
  }

  @media (max-width: 359px) {
    .about-banner :global(.page-hero__summary) {
      font-size: 12px;
    }
  }
</style>
