---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getPostDate, getPostExcerpt } from '../../lib/content/posts';
import { validatePublishedTimeline } from '../../features/timeline/timeline-config';
import { timelineToday } from '../../features/timeline/date';
import LifeTimeline from '../../features/timeline/LifeTimeline';
const articles = (await getPublishedPosts()).map(post => ({ slug: post.data.slug, date: getPostDate(post), title: post.data.title, excerpt: getPostExcerpt(post) })).sort((a, b) => a.date.localeCompare(b.date));
validatePublishedTimeline(articles);
const initialDate = timelineToday();
---
<BaseLayout title="一路走来" description="经历、作品，以及当时的记录。">
  <LifeTimeline articles={articles} initialDate={initialDate} client:load />
</BaseLayout>
