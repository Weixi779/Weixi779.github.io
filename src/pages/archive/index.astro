---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteBanner from '../../components/SiteBanner';
import ArchiveBrowser from '../../components/ArchiveBrowser';
import { normalizeArchiveSearch, type ArchivePost } from '../../utils/archive';
import { getPostDate, getPostExcerpt, getPostPath, getPublishedPosts } from '../../utils/posts';
import { countPostWords } from '../../utils/post-word-count';
import '../../styles/archive.css';

const posts = await getPublishedPosts();
const totalWords = (await Promise.all(posts.map(post => countPostWords(post.body ?? ''))))
  .reduce((total, count) => total + count, 0);
const archivePosts: ArchivePost[] = posts.map((post) => {
  const year = getPostDate(post).slice(0, 4);
  const excerpt = post.data.summary ?? getPostExcerpt(post, 180);
  const searchText = normalizeArchiveSearch(
    [post.data.title, excerpt, post.data.category, ...post.data.tags, year].join(' '),
  );

  return {
    slug: post.data.slug,
    href: getPostPath(post),
    title: post.data.title,
    category: post.data.category,
    tags: post.data.tags,
    year,
    searchText,
  };
});
const categoryCounts = posts.reduce((counts, post) => {
  counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1);
  return counts;
}, new Map<string, number>());
const categories = Array.from(categoryCounts, ([name, count]) => ({ name, count })).sort(
  (left, right) => right.count - left.count || left.name.localeCompare(right.name, 'zh-CN'),
);
---

<BaseLayout title="归档" description="一点一滴，直到汇聚成改变世界的力量">
  <div class="archive-banner">
    <SiteBanner title="归档" summary="一点一滴，直到汇聚成改变世界的力量" image="/images/archive-banner.webp">
      <p class="archive-stats" aria-label="归档统计">
        <span>共 <strong>{posts.length}</strong> 篇文章</span>
        <span class="archive-stats__divider" aria-hidden="true"></span>
        <span>累计约 <strong>{(totalWords / 10000).toFixed(1)}</strong> 万字</span>
      </p>
    </SiteBanner>
  </div>
  <ArchiveBrowser posts={archivePosts} categories={categories} client:load />
</BaseLayout>
