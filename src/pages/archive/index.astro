---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostDate, getPostExcerpt, getPostPath, getPublishedPosts } from '../../utils/posts';
import '../../styles/archive.css';

const posts = await getPublishedPosts();
const archivePosts = posts.map((post) => {
  const year = getPostDate(post).slice(0, 4);
  const excerpt = post.data.summary ?? getPostExcerpt(post, 180);
  const searchText = [post.data.title, excerpt, post.data.category, ...post.data.tags, year]
    .join(' ')
    .normalize('NFKC')
    .toLocaleLowerCase('zh-CN');

  return { post, year, searchText };
});
const years = new Map<string, typeof archivePosts>();
const categoryCounts = posts.reduce((counts, post) => {
  counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1);
  return counts;
}, new Map<string, number>());
const categories = Array.from(categoryCounts.keys()).sort(
  (left, right) =>
    (categoryCounts.get(right) ?? 0) - (categoryCounts.get(left) ?? 0) ||
    left.localeCompare(right, 'zh-CN'),
);

for (const archivePost of archivePosts) {
  years.set(archivePost.year, [...(years.get(archivePost.year) ?? []), archivePost]);
}
---

<BaseLayout title="归档" description="一点一滴，直到汇聚成改变世界的力量">
  <header class="page-hero page-hero--centered" style="--hero-image: url('/images/archive_banner.png')">
    <div class="page-hero__overlay">
      <div class="page-hero__content">
        <h1>归档</h1>
        <p>一点一滴，直到汇聚成改变世界的力量</p>
      </div>
    </div>
  </header>
  <div class="content-container archive-page" data-archive-page>
    <div class="archive-controls">
      <form class="archive-search" role="search" data-archive-search>
        <label class="visually-hidden" for="archive-search-input">搜索文章</label>
        <input
          id="archive-search-input"
          type="search"
          placeholder="搜索标题、摘要、分类或标签"
          autocomplete="off"
          aria-controls="archive-results"
          aria-describedby="archive-result-status"
          data-archive-search-input
        />
        <button type="button" data-archive-search-clear hidden>清除</button>
      </form>
      <p id="archive-result-status" class="archive-result-status" aria-live="polite">
        <span data-archive-result-count>{posts.length}</span> 篇文章
      </p>
    </div>
    <nav class="archive-categories" aria-label="按分类筛选文章">
      <a href="/archive/" data-category="">全部 <sup>{posts.length}</sup></a>
      {categories.map((category) => (
        <a href={`/archive/?category=${encodeURIComponent(category)}`} data-category={category}>
          {category}
          <sup>{categoryCounts.get(category)}</sup>
        </a>
      ))}
    </nav>
    <div id="archive-results" data-archive-results>
      {Array.from(years.entries()).map(([year, yearPosts]) => (
        <section class="archive-year" data-archive-year>
          <h2 style={`view-transition-name: archive-year-${year}`}>{year}</h2>
          <ol>
            {yearPosts.map(({ post, searchText }) => (
              <li
                class="archive-item"
                data-archive-item
                data-search={searchText}
                data-category={post.data.category}
                style={`view-transition-name: archive-${post.data.slug}`}
              >
                <a class="archive-item__link" href={getPostPath(post)}>{post.data.title}</a>
                <span class="archive-item__meta">
                  {post.data.tags.length > 0 ? post.data.tags.join(' / ') : post.data.category}
                </span>
              </li>
            ))}
          </ol>
        </section>
      ))}
      <p class="archive-empty" data-archive-empty hidden>没有找到匹配的文章。</p>
    </div>
  </div>
  <script>
    interface ArchiveViewTransition {
      finished: Promise<unknown>;
    }

    type ArchiveDocument = Document & {
      startViewTransition?: (update: () => void) => ArchiveViewTransition;
    };

    function setupArchive() {
      const page = document.querySelector<HTMLElement>('[data-archive-page]');
      const form = page?.querySelector<HTMLFormElement>('[data-archive-search]');
      const input = page?.querySelector<HTMLInputElement>('[data-archive-search-input]');
      const clearButton = page?.querySelector<HTMLButtonElement>('[data-archive-search-clear]');
      const resultCount = page?.querySelector<HTMLElement>('[data-archive-result-count]');
      const emptyState = page?.querySelector<HTMLElement>('[data-archive-empty]');
      const categoryLinks = Array.from(
        page?.querySelectorAll<HTMLAnchorElement>('[data-category]') ?? [],
      );
      const years = Array.from(page?.querySelectorAll<HTMLElement>('[data-archive-year]') ?? []);
      const items = Array.from(page?.querySelectorAll<HTMLElement>('[data-archive-item]') ?? []).map(
        (element) => ({
          element,
          searchText: element.dataset.search ?? '',
          category: element.dataset.category ?? '',
        }),
      );

      if (!page || !form || !input || !clearButton || !resultCount || !emptyState) return;

      const archiveForm = form;
      const searchInput = input;
      const searchClearButton = clearButton;
      const searchResultCount = resultCount;
      const archiveEmptyState = emptyState;
      const availableCategories = new Set(
        categoryLinks.map((link) => link.dataset.category ?? ''),
      );
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const archiveDocument = document as ArchiveDocument;
      let activeCategory = '';
      let transitionSequence = 0;

      const normalizeQuery = (value: string) =>
        value.normalize('NFKC').trim().toLocaleLowerCase('zh-CN');

      function readUrlState() {
        const params = new URLSearchParams(window.location.search);
        const requestedCategory = params.get('category') ?? '';
        activeCategory = availableCategories.has(requestedCategory) ? requestedCategory : '';
        searchInput.value = params.get('q') ?? '';
      }

      function writeUrl(mode: 'push' | 'replace') {
        const url = new URL(window.location.href);
        const query = searchInput.value.trim();

        activeCategory
          ? url.searchParams.set('category', activeCategory)
          : url.searchParams.delete('category');
        url.searchParams.delete('tag');
        query ? url.searchParams.set('q', query) : url.searchParams.delete('q');

        if (mode === 'push') {
          window.history.pushState({}, '', url);
        } else {
          window.history.replaceState({}, '', url);
        }
      }

      function applyFilters() {
        const query = normalizeQuery(searchInput.value);
        let visibleCount = 0;

        for (const item of items) {
          const matchesCategory = !activeCategory || item.category === activeCategory;
          const matchesQuery = !query || item.searchText.includes(query);
          item.element.hidden = !(matchesCategory && matchesQuery);
          if (!item.element.hidden) visibleCount += 1;
        }

        for (const year of years) {
          year.hidden = !Array.from(year.querySelectorAll<HTMLElement>('[data-archive-item]')).some(
            (item) => !item.hidden,
          );
        }

        for (const link of categoryLinks) {
          if ((link.dataset.category ?? '') === activeCategory) {
            link.setAttribute('aria-current', 'page');
          } else {
            link.removeAttribute('aria-current');
          }
        }

        searchResultCount.textContent = String(visibleCount);
        searchClearButton.hidden = searchInput.value.length === 0;
        archiveEmptyState.hidden = visibleCount !== 0;
      }

      function updateResults(animate: boolean) {
        const startViewTransition = archiveDocument.startViewTransition?.bind(archiveDocument);
        if (!animate || reducedMotion.matches || !startViewTransition) {
          applyFilters();
          return;
        }

        const sequence = ++transitionSequence;
        document.documentElement.classList.add('archive-is-transitioning');
        const transition = startViewTransition(applyFilters);
        transition.finished.finally(() => {
          if (sequence === transitionSequence) {
            document.documentElement.classList.remove('archive-is-transitioning');
          }
        });
      }

      for (const link of categoryLinks) {
        link.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          const nextCategory = link.dataset.category ?? '';
          if (nextCategory === activeCategory) return;
          activeCategory = nextCategory;
          writeUrl('push');
          updateResults(true);
        });
      }

      searchInput.addEventListener('input', () => {
        writeUrl('replace');
        updateResults(false);
      });

      searchInput.addEventListener('search', () => {
        writeUrl('replace');
        updateResults(false);
      });

      searchClearButton.addEventListener('click', () => {
        searchInput.value = '';
        writeUrl('replace');
        updateResults(false);
        searchInput.focus();
      });

      archiveForm.addEventListener('submit', (event) => {
        event.preventDefault();
        writeUrl('replace');
      });

      window.addEventListener('popstate', () => {
        readUrlState();
        updateResults(true);
      });

      readUrlState();
      applyFilters();
    }

    setupArchive();
  </script>
</BaseLayout>
