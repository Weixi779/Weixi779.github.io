---
import { render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { getPostStaticPaths, type PostRouteProps } from '../../../utils/posts';

export async function getStaticPaths() {
  return getPostStaticPaths('en');
}

const { post, translation, newerPost, olderPost } = Astro.props as PostRouteProps;
const { Content, headings } = await render(post);
---

<PostLayout
  post={post}
  translation={translation}
  headings={headings}
  newerPost={newerPost}
  olderPost={olderPost}
>
  <Content />
</PostLayout>
