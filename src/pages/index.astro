---
import HomeHero from '../components/HomeHero.astro';
import HomeRecentPosts from '../components/HomeRecentPosts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostDate, getPostExcerpt, getPostPath, getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 5).map(post => ({
  href: getPostPath(post),
  title: post.data.title,
  category: post.data.category,
  publishedAt: getPostDate(post),
  summary: post.data.summary || getPostExcerpt(post),
}));
---

<BaseLayout>
  <HomeHero />
  <div class="home-sections">
    <HomeRecentPosts posts={recentPosts} />
    <aside class="home-sections__placeholder" aria-label="更多内容（占位）">
      <h2>更多日常</h2>
      <p>这里的内容，会慢慢添上。</p>
    </aside>
  </div>
</BaseLayout>
